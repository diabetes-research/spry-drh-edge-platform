{
  "servers": {
    "surveilr": {
      "command": "surveilr",
      "args": [
        "mcp",
        "server",
        "-d",
        "./drh-edge-core/resource-surveillance.sqlite.db"
      ],
      "env": {}
    },
    "drh-orchestrator": {
      "command": "python3",
      "args": [
        "drh-edge-core/mcp-tools/drh-orchestrator-server.py"
      ],
      "env": {
        "PYTHONPATH": ".:./drh-edge-core"
      }
    }
  }
}
